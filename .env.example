# =============================================================================
# MIPS ERP Environment Configuration Template
# COPY TO .env FOR LOCAL DEVELOPMENT ONLY. NEVER COMMIT REAL KEYS TO GIT.
# =============================================================================

# Supabase Project Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# SERVICE ROLE KEY: Elevated server key for Edge Functions and bootstrap scripts ONLY.
# NEVER bundle into Flutter, React client, or commit to any repository.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Host & Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://admin.mips.edu

# Cloudflare Turnstile (Optional for development; required for production brute-force defence)
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
